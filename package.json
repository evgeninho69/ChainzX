{
  "name": "chainz-mvp",
  "version": "1.0.0",
  "description": "CHAINZ - Telegram bot for referral empire game",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "start:bot": "node dist/index.js",
    "start:admin": "node dist/admin/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:admin": "ts-node-dev --respawn --transpile-only src/admin/server.ts",
    "migrate": "ts-node src/database/migrations/run.ts",
    "migrate:prod": "node run-migrations.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "referral",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "i18n": "^0.15.1",
    "pg": "^8.11.3",
    "telegraf": "^4.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/i18n": "^0.13.12",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
